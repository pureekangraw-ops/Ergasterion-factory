{
  "manifest_version": 3,
  "name": "ERGASTERION Factory Eye",
  "version": "0.2.0",
  "description": "Neutral tab-level Firefox observer for the ERGASTERION Runtime Workbench.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-observer.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ERGASTERION Factory Eye — refresh"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ergasterion-factory-eye@pureekangraw.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  }
}
