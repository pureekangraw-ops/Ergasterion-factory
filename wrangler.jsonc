{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ergasterion-factory",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "FACTORY_STATE",
        "class_name": "ErgasterionFactoryState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-factory-state",
      "new_sqlite_classes": ["ErgasterionFactoryState"]
    }
  ],
  "assets": {
    "directory": "pixie-lab-v1/ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
