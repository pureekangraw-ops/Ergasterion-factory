      "labOwned": true,
      "status": "DRAFT",
      "originalSpec": {
        "ideaBoard": {
          "title": "Lost Era — Final Sales Visual Direction",
          "pinned": [
            "Normal first. Strange second.",
            "One continuous location.",
            "One simple anomaly per image.",
            "Do not look like a tourism campaign.",
            "Product proof uses a real screenshot later."
          ]
        },
        "creativeBrief": {
          "product": "Lost Era",
          "purpose": "Product Showcase for a real digital worldbuilding product sales page",
          "coreIdea": "A normal working urban district gradually reveals that an older layout still occupies the same physical space. Lost Era helps turn that anomaly into a usable, coherent story.",
          "location": {
            "type": "ordinary canal-side urban service/transit district",
            "recurringAnchors": [
              "same narrow canal",
              "same small stone bridge",
              "same main occupied building",
              "same old stone arch doorway at ground level",
              "same modern pedestrian/transit infrastructure"
            ]
          },
          "visualRules": [
            "80% ordinary reality, 20% anomaly",
            "eye-level or near eye-level camera",
            "medium/close framing; no sightseeing vista",
            "one anomaly per image",
            "warm dusk light, believable architecture, restrained fantasy",
            "same place and anchors across the sequence",
            "no generated text inside images"
          ],
          "avoid": [
            "portal",
            "floating buildings",
            "cosmic sky",
            "apocalypse",
            "large destruction",
            "generic glitch effects",
            "grand skyline",
            "tourism-poster composition",
            "fake Notion UI",
            "fake readable text",
            "random letters",
            "logos",
            "watermarks",
            "clutter"
          ],
          "salesSet": [
            {
              "id": 1,
              "name": "Hero",
              "goal": "Stop the viewer. Normal place, one wrong-era detail."
            },
            {
              "id": 2,
              "name": "Before",
              "goal": "Establish the same location as completely usable and ordinary."
            },
            {
              "id": 3,
              "name": "First Clue",
              "goal": "Reveal a short old stone staircase where modern solid ground should be."
            },
            {
              "id": 4,
              "name": "Old Access",
              "goal": "Open the same stone doorway into an older corridor belonging to the same building."
            },
            {
              "id": 5,
              "name": "Functional Mismatch",
              "goal": "Show modern infrastructure physically conflicting with the older layout."
            },
            {
              "id": 6,
              "name": "Product Proof",
              "goal": "Keep a clean illuminated insert area for a real template screenshot added later; generate no device or UI."
            }
          ]
        },
        "promptSet": {
          "master": "Grounded cinematic editorial illustration, photorealistic believable architecture, ordinary canal-side urban service district at warm dusk, restrained color palette, eye-level camera, medium framing, same narrow canal, same small stone bridge, same occupied main building, same old stone arch doorway, same modern pedestrian/transit infrastructure. The location is functional and lived-in, not picturesque. Keep 80% ordinary present-day reality and only 20% anomaly. No text, labels, logos, UI, watermarks, portals, cosmic effects, giant skyline, apocalypse, or clutter.",
          "images": [
            {
